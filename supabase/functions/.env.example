# Edge function secrets -> copy to supabase/functions/.env (local) or `npx supabase secrets set` (production).
# Never prefix with VITE_: these must not reach the browser.

# gemini (default, free tier at aistudio.google.com/apikey; free-tier inputs may be used by Google) | claude
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: defaults to gemini-3.6-flash (falls back to gemini-3.5-flash-lite when overloaded) / claude-opus-5-5
AI_MODEL=
SCAN_DAILY_LIMIT=30
